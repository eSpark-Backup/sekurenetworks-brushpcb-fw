quads[3]\), Math.min\(quads[5], quads[7]\\)\);                 \r\n    var qBottom = Math.max\(Math.max\(quads[1], quads[3]\), Math.max\(quads[5], quads[7]\)\);              \r\n    if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj34 0 obj<</JS(function ShowCompProps_4EFDC0EE7094433FBFBD37EAADB43EA9\(\){var sChoice = app.popUpMenu\("Comment: 0.1 \\u00B5F","Component Kind: Standard","Description: CAP CER 0.1UF 50V X7R 0603","Footprint: CAP0603","Ibis Model: ","Library Name: Schlib1.SchLib","Libra\ry Reference: Capacitor","Part: CL10B104KB8NNNC","PCB3D: ","Pin Info: ","Signal Integrity: ","Simulation: ","Value: 0.1 \\u00B5F"\); if \(sChoice\) {var nUrlPos = sChoice.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchUR\L\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sChoice.substr\(nPathPos+2\)\);};};})/S/JavaScript>>endobj35 0 obj<</JS(function ShowCompProps_8A1E6876784848248156EEA30A11E0BB\(\){var sChoice = app.popUpMenu\("Comment: 5034801000","Component Kind: Standard","Description: 10 Position FFC, FPC